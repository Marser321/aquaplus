# =============================================================================
# Aqua Plus System Web · .env.example
# =============================================================================
# Copiar a `.env.local` y rellenar. NUNCA commitear `.env.local`.
# =============================================================================

# ---------- App ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="es"

# ---------- Observability ----------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---------- Lead service (V1.5+) ----------
# Mock activo en V1; cuando se active GHL, completar:
LEAD_SERVICE_MODE="mock" # mock | ghl
GHL_API_KEY=""
GHL_LOCATION_ID=""
GHL_WEBHOOK_SECRET=""

# ---------- Rate limiting ----------
# En V1 se usa memoria local en dev; en prod usar Vercel KV o Upstash Redis:
RATELIMIT_REDIS_URL=""
RATELIMIT_REDIS_TOKEN=""

# ---------- Email (V1.5+) ----------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@aquaplus.example"
